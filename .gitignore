# Never commit the sandbox or local build artifacts
/Screenshots/
psx_autobuild.flag
psx_screenshot.flag
PSXRacing_build_log.txt

# IDE
.vs/
.idea/
*.csproj
*.sln
*.slnx
*.user

# OS
.DS_Store
Thumbs.db

# Paid Asset Store content - the repo is public, do not redistribute
Assets/PSXShaderKit/
Assets/PSXShaderKit.meta

tools/brp/cache/
# The generalised road bake downloads SRTM tiles and Overpass results here.
# 15 MB and up per road, all of it re-fetchable, none of it source.
tools/roads/cache/

# Overpass bodies + SRTM for the Charlotte city bake (tools/city/export_osm.mjs), and
# its debug plots, which it redraws in five seconds
tools/city/cache/
tools/city/charlotte_*.png

# Python bytecode from the tools
__pycache__/

# The Enhanced texture bundle: a build product, made from
# Assets/PSXRacing/EnhancedSrc right before every player build
# (TextureTierTool.BuildBundle, called by PSXBuildWebGL) and shipped beside
# the page as StreamingAssets/texenhanced.bundle.
/Assets/StreamingAssets/texenhanced.bundle
/Assets/StreamingAssets/texenhanced.bundle.meta
# The owner's v08 cockpit, the same way (Editor/CockpitBundle.cs).
/Assets/StreamingAssets/cockpit.bundle
/Assets/StreamingAssets/cockpit.bundle.meta
/Assets/StreamingAssets.meta
